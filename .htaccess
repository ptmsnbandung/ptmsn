<IfModule mod_rewrite.c>
    RewriteEngine On

    # =====================================================================
    # 1. SECURITY: Block access to sensitive files (.env, .git, etc.)
    # =====================================================================
    <FilesMatch "^\.(env|git|editorconfig|gitattributes|gitignore)|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|artisan">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # =====================================================================
    # 2. SECURITY: Block direct web access to core system directories
    # =====================================================================
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L,NC]

    # =====================================================================
    # 3. HTTP HEADERS: Handle Authorization Header
    # =====================================================================
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # =====================================================================
    # 4. URL REWRITE: Transparently route all traffic into the public/ folder
    # =====================================================================
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Prevent directory indexing / browsing
Options -Indexes
